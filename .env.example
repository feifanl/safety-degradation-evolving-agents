# Copy to .env and fill in. .env is gitignored.
#
# Local vLLM endpoint
# The key is NOT validated by vLLM; any non-empty string works.
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://localhost:8000/v1

# Model served by vLLM (must match --served-model-name in serving/serve.sh).
BACKBONE_MODEL=qwen3-vl-32b

# ASR judge model (this replication uses the same local model as judge).
JUDGE_MODEL=qwen3-vl-32b

# Optional: hosted APIs for the 675B-class models that don't fit locally
# (Qwen3-235B-A22B, DeepSeek-V3.2). Leave blank to stay fully local.
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
